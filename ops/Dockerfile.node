FROM node:20-alpine

RUN apk add --no-cache python3 make g++

WORKDIR /app

# Copy dependency manifests and project code
COPY package*.json ./
COPY packages ./packages
COPY apps ./apps
COPY db ./db
COPY scripts ./scripts
COPY tsconfig.json ./

# Install dependencies across all workspaces
RUN npm install

EXPOSE 3000

CMD ["npx", "tsx", "apps/api/src/index.ts"]
