{
  "name": "filspay",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present && tsc -p db --noEmit && tsc -p scripts --noEmit",
    "test": "DATABASE_URL=\"${DATABASE_URL:-postgres://filspay:filspay_dev_password@localhost:5432/filspay?sslmode=disable}\" npm run test --workspaces --if-present && DATABASE_URL=\"${DATABASE_URL:-postgres://filspay:filspay_dev_password@localhost:5432/filspay?sslmode=disable}\" tsx --test scripts/*.test.ts",
    "migrate": "DATABASE_URL=\"${DATABASE_URL:-postgres://filspay:filspay_dev_password@localhost:5432/filspay?sslmode=disable}\" tsx db/migrate.ts",
    "seed": "DATABASE_URL=\"${DATABASE_URL:-postgres://filspay:filspay_dev_password@localhost:5432/filspay?sslmode=disable}\" tsx db/seed/index.ts"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "@types/pg": "^8.11.6",
    "typescript": "^5.6.3",
    "tsx": "^4.19.1"
  },
  "dependencies": {
    "pg": "^8.13.1"
  }
}
